VITE_QUEUE_API_PATH=/api

# Optional, dev server only: where `npm run dev` proxies /api calls. Point it at
# a running serve.py (https://<instance-ip>:8998) to develop the client against
# a real backend. Left unset, no proxy is installed and /api calls 404 — use
# /?worker_addr=<host:port> instead, which talks to the instance directly.
# VITE_QUEUE_API_URL=
